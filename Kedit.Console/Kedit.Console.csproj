<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Kedit.Console</RootNamespace>
    <AssemblyName>Kedit.Console</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <TargetFrameworkProfile />
    <FileAlignment>512</FileAlignment>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <OutputPath>bin\Debug\</OutputPath>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <OutputPath>bin\Release\</OutputPath>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" /><Reference Include="System.Net.Http" /><Reference Include="System.IO.Compression" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>..\.packages\Microsoft.Web.WebView2.1.0.3537.50\lib\net462\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.Wpf">
      <HintPath>..\.packages\Microsoft.Web.WebView2.1.0.3537.50\lib\net462\Microsoft.Web.WebView2.Wpf.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
    <Page Include="MainWindow.xaml" />
    <Compile Include="App.xaml.cs" />
    <Compile Include="DesignPreview.cs" />
    <Compile Include="ShortcutPage.cs" />
    <Compile Include="PageMedia.cs" /><Compile Include="CloudContent.cs" /><Compile Include="CloudPanels.cs" />
    <Compile Include="PreviewCrop.cs" />
    <Compile Include="MainWindow.xaml.cs" />
    <Compile Include="Pet\PetRuntime.cs" />
    <Compile Include="Pet\PetSettings.cs" />
    <Compile Include="Pet\PetModel.cs" />
    <Compile Include="Pet\PetController.cs" />
    <Compile Include="Pet\PetSchedule.cs" />
    <Compile Include="Pet\PetAudio.cs" />
    <Compile Include="Pet\PetAutomation.cs" />
    <Compile Include="Pet\PetAutomationPanel.cs" />
    <Compile Include="Pet\PetWindow.cs" />
    <Compile Include="Pet\PetPalmCursor.cs" />
    <Compile Include="Pet\PetInput.cs" />
    <Compile Include="Pet\PetDiagnostics.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\Gitea\home.json"><LogicalName>CloudDefaults/home.json</LogicalName></EmbeddedResource><EmbeddedResource Include="..\Gitea\models.json"><LogicalName>CloudDefaults/models.json</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="PetWeb\**\*">
      <LogicalName>PetWeb/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\photo\default_logo.png"><LogicalName>PreviewAssets/default_logo.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="PreviewAssets\*.png" Exclude="PreviewAssets\avatar.png">
      <LogicalName>PreviewAssets/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\.packages\Microsoft.Web.WebView2.1.0.3537.50\lib\net462\Microsoft.Web.WebView2.Core.dll">
      <LogicalName>PetRuntime/Microsoft.Web.WebView2.Core.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\.packages\Microsoft.Web.WebView2.1.0.3537.50\lib\net462\Microsoft.Web.WebView2.Wpf.dll">
      <LogicalName>PetRuntime/Microsoft.Web.WebView2.Wpf.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\.packages\Microsoft.Web.WebView2.1.0.3537.50\runtimes\win-x64\native\WebView2Loader.dll">
      <LogicalName>PetRuntime/x64/WebView2Loader.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\.packages\Microsoft.Web.WebView2.1.0.3537.50\runtimes\win-x86\native\WebView2Loader.dll">
      <LogicalName>PetRuntime/x86/WebView2Loader.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="PageMedia.targets" />
</Project>
