<Window x:Class="Kedit.Console.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kedit 中控" Width="1080" Height="670" MinWidth="850" MinHeight="540"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True" Loaded="MainWindow_Loaded">
  <Window.Resources>
    <Style x:Key="RoundButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#66334255"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/>
      <Setter Property="FontSize" Value="16"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="17"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value>
      </Setter>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B88C6900"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="ShortcutButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#CC1B3044"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,13"/><Setter Property="Margin" Value="0,0,16,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#CC6C570D"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#66334B61"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,12"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#AA6C570D"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#66334255"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B88C6900"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="RoundedTextBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="#172433"/><Setter Property="Background" Value="#F5F7FA"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,7"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="RootCard" Margin="14" CornerRadius="22" Background="#101923" BorderBrush="#364F69" BorderThickness="1" SizeChanged="RootCard_SizeChanged">
    <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.55" Color="#000000"/></Border.Effect>
    <Grid Background="#101923">
      <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <MediaElement x:Name="BackgroundVideo" Grid.ColumnSpan="2" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="UniformToFill" Opacity="0.45" IsHitTestVisible="False" MediaEnded="BackgroundVideo_MediaEnded"/>
      <Border Background="#66132234" CornerRadius="18" Margin="10" Padding="22,30" BorderBrush="#334D6478" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="KEDIT" FontSize="25" FontWeight="Bold" Foreground="White" Margin="0,0,0,26"/>
          <TextBlock Text="功能分类" Foreground="#91ABC1" Margin="0,0,0,10"/>
          <Button Style="{StaticResource NavButton}" Content="Kedit 快捷键" Tag="kedit" Click="Category_Click"/>
          <Button Style="{StaticResource NavButton}" Content="Visual Studio" Tag="vs" Click="Category_Click"/>
          <Button Style="{StaticResource NavButton}" Content="其他快捷键" Tag="other" Click="Category_Click"/>
          <Separator Margin="0,14,0,16"/>
          <Button Style="{StaticResource NavButton}" Content="通用设置" Tag="system" Click="Category_Click"/>
        </StackPanel>
      </Border>
      <Grid Grid.Column="1" Margin="30,24,30,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
          <TextBlock x:Name="PageTitle" Text="Kedit 快捷键" FontSize="27" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource RoundButton}" Content="−" Click="MinimizeButton_Click" Margin="0,0,8,0"/>
            <Button Style="{StaticResource RoundButton}" Content="×" Click="CloseButton_Click"/>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,24,0,10">
          <ScrollViewer x:Name="ListPage" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock x:Name="CategoryDescription" Foreground="#BFD8EF" FontSize="14" Margin="0,0,0,18" TextWrapping="Wrap"/>
              <Border Background="#AA0B1726" CornerRadius="18" Padding="14" Margin="0,28,0,0" BorderBrush="#334D6478" BorderThickness="1">
                <StackPanel>
                  <DockPanel Margin="4,0,4,12">
                    <TextBlock Text="快捷键功能" Foreground="#FFDD38" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock DockPanel.Dock="Right" Text="选择项目查看详情" Foreground="#91ABC1" FontSize="12" VerticalAlignment="Center"/>
                  </DockPanel>
                  <WrapPanel x:Name="ShortcutList"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <Grid x:Name="DetailPage" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Button Style="{StaticResource RoundButton}" Content="←" ToolTip="返回列表" Click="Back_Click" HorizontalAlignment="Left"/>
            <Grid Grid.Row="1" Margin="0,20,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
              <Border Background="#AA1A2C3E" CornerRadius="18" Padding="16" Margin="0,0,16,0" BorderBrush="#334D6478" BorderThickness="1">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Text="演示视频" Foreground="#FFDD38" FontSize="17" FontWeight="SemiBold"/>
                  <Grid Grid.Row="1" Margin="0,12,0,12" Background="#0B1420">
                    <MediaElement x:Name="DemoVideo" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="UniformToFill" Volume="0" MediaEnded="DemoVideo_MediaEnded" MediaFailed="DemoVideo_MediaFailed"/>
                    <TextBlock x:Name="VideoPlaceholder" Text="演示视频准备中" Foreground="#BFD8EF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                  <TextBlock x:Name="VideoPathHint" Grid.Row="2" Foreground="#91ABC1" FontSize="12" TextWrapping="Wrap"/>
                </Grid>
              </Border>
              <Border Grid.Column="1" Background="#AA1A2C3E" CornerRadius="18" Padding="20" BorderBrush="#334D6478" BorderThickness="1">
                <StackPanel>
                  <TextBlock x:Name="DetailTitle" Foreground="White" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
                  <TextBlock x:Name="DetailDescription" Foreground="#BFD8EF" TextWrapping="Wrap" Margin="0,12,0,22"/>
                  <TextBlock Text="当前快捷键" Foreground="#BFD8EF"/>
                  <TextBox x:Name="HotkeyInput" Style="{StaticResource RoundedTextBox}" FontSize="20" Margin="0,7,0,9" IsReadOnly="True" PreviewKeyDown="HotkeyInput_PreviewKeyDown" PreviewMouseDown="HotkeyInput_PreviewMouseDown"/>
                  <TextBlock Text="点击输入框，然后按下键盘组合键或鼠标侧键。" Foreground="#91ABC1" TextWrapping="Wrap" FontSize="12"/>
                  <StackPanel Orientation="Horizontal" Margin="0,25,0,0">
                    <Button Style="{StaticResource ActionButton}" Content="保存快捷键" Click="SaveHotkey_Click"/>
                    <Button Style="{StaticResource ActionButton}" Content="恢复默认" Click="RestoreDefault_Click"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
          <StackPanel x:Name="SystemPage" Visibility="Collapsed">
            <TextBlock Text="通用设置" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,18"/>
            <CheckBox x:Name="AutoUpdateToggle" Content="自动检查更新" Foreground="White" FontSize="16" IsEnabled="False" Margin="0,0,0,20" Checked="AutoUpdateToggle_Changed" Unchecked="AutoUpdateToggle_Changed"/>
            <CheckBox x:Name="OsdToggle" Content="屏幕操作提示 (OSD)" Foreground="White" FontSize="16" IsEnabled="False" Checked="OsdToggle_Changed" Unchecked="OsdToggle_Changed"/>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="PipeStatus" Grid.Row="2" Text="正在等待 Kedit 主程序连接..." Foreground="#BFD8EF" FontSize="12" TextWrapping="Wrap"/>
      </Grid>
    </Grid>
  </Border>
</Window>
