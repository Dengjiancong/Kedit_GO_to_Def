<Window x:Class="Kedit.Console.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kedit 中控" Width="1080" Height="670" MinWidth="850" MinHeight="540"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True" Loaded="MainWindow_Loaded">
  <Window.Resources>
    <Style x:Key="RoundButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#66334255"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/>
      <Setter Property="FontSize" Value="16"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/><Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="17"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value>
      </Setter>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B88C6900"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#E0A87800"/><Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.92" ScaleY="0.92"/></Setter.Value></Setter></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="ShortcutButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#CC1B3044"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,13"/><Setter Property="Margin" Value="0,0,16,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/><Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#CC6C570D"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#E0A87800"/><Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#66334B61"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,12"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/><Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#AA6C570D"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#E0A87800"/><Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value></Setter></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#66334255"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/><Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B88C6900"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#E0A87800"/><Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.94" ScaleY="0.94"/></Setter.Value></Setter></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="RoundedTextBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="#172433"/><Setter Property="Background" Value="#F5F7FA"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,7"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="RootCard" Margin="14" CornerRadius="22" Background="#101923" BorderBrush="#364F69" BorderThickness="1" SizeChanged="RootCard_SizeChanged">
    <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.55" Color="#000000"/></Border.Effect>
    <Grid Background="#101923">
      <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <MediaElement x:Name="BackgroundVideo" Grid.ColumnSpan="2" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="UniformToFill" Opacity="0.60" IsHitTestVisible="False" MediaEnded="BackgroundVideo_MediaEnded"/>
      <Border Background="#66132234" CornerRadius="18" Margin="10" Padding="22,30" BorderBrush="#334D6478" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="KEDIT" FontSize="25" FontWeight="Bold" Foreground="White" Margin="0,0,0,26"/>
          <TextBlock Text="功能分类" Foreground="#91ABC1" Margin="0,0,0,10"/>
          <Button Style="{StaticResource NavButton}" Content="Kedit 快捷键" Tag="kedit" Click="Category_Click"/>
          <Button Style="{StaticResource NavButton}" Content="Visual Studio" Tag="vs" Click="Category_Click"/>
          <Button Style="{StaticResource NavButton}" Content="其他快捷键" Tag="other" Click="Category_Click"/>
          <Separator Margin="0,14,0,16"/>
          <Button Style="{StaticResource NavButton}" Content="通用设置" Tag="system" Click="Category_Click"/>
          <Button Style="{StaticResource NavButton}" Content="Live2D 桌宠" Tag="pet" Click="Category_Click"/>
        </StackPanel>
      </Border>
      <Grid Grid.Column="1" Margin="30,24,30,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
          <TextBlock x:Name="PageTitle" Text="Kedit 快捷键" FontSize="27" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource RoundButton}" Content="−" Click="MinimizeButton_Click" Margin="0,0,8,0"/>
            <Button Style="{StaticResource RoundButton}" Content="×" Click="CloseButton_Click"/>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,24,0,10">
          <ScrollViewer x:Name="ListPage" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock x:Name="CategoryDescription" Foreground="#BFD8EF" FontSize="14" Margin="0,0,0,18" TextWrapping="Wrap"/>
              <Border Background="#AA0B1726" CornerRadius="18" Padding="14" Margin="0,285,0,0" BorderBrush="#334D6478" BorderThickness="1">
                <StackPanel>
                  <DockPanel Margin="4,0,4,12">
                    <TextBlock Text="快捷键功能" Foreground="#FFDD38" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock DockPanel.Dock="Right" Text="选择项目查看详情" Foreground="#91ABC1" FontSize="12" VerticalAlignment="Center"/>
                  </DockPanel>
                  <WrapPanel x:Name="ShortcutList"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <Grid x:Name="DetailPage" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Button x:Name="BackButton" Style="{StaticResource RoundButton}" Content="←" ToolTip="返回列表" Click="Back_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="20"/>
            <Grid Grid.Row="1" Margin="0,20,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
              <Border Background="#AA1A2C3E" CornerRadius="18" Padding="16" Margin="0,0,16,0" BorderBrush="#334D6478" BorderThickness="1">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Text="演示视频" Foreground="#FFDD38" FontSize="17" FontWeight="SemiBold"/>
                  <Grid Grid.Row="1" Margin="0,12,0,12" Background="#0B1420">
                    <MediaElement x:Name="DemoVideo" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="UniformToFill" Volume="0" MediaEnded="DemoVideo_MediaEnded" MediaFailed="DemoVideo_MediaFailed"/>
                    <TextBlock x:Name="VideoPlaceholder" Text="演示视频准备中" Foreground="#BFD8EF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                  <TextBlock x:Name="VideoPathHint" Grid.Row="2" Foreground="#91ABC1" FontSize="12" TextWrapping="Wrap"/>
                </Grid>
              </Border>
              <Border Grid.Column="1" Background="#AA1A2C3E" CornerRadius="18" Padding="20" BorderBrush="#334D6478" BorderThickness="1">
                <StackPanel>
                  <TextBlock x:Name="DetailTitle" Foreground="White" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
                  <TextBlock x:Name="DetailDescription" Foreground="#BFD8EF" TextWrapping="Wrap" Margin="0,12,0,22"/>
                  <TextBlock Text="当前快捷键" Foreground="#BFD8EF"/>
                  <TextBox x:Name="HotkeyInput" Style="{StaticResource RoundedTextBox}" FontSize="20" Margin="0,7,0,9" IsReadOnly="True" PreviewKeyDown="HotkeyInput_PreviewKeyDown" PreviewMouseDown="HotkeyInput_PreviewMouseDown"/>
                  <TextBlock Text="点击输入框，然后按下键盘组合键或鼠标侧键。" Foreground="#91ABC1" TextWrapping="Wrap" FontSize="12"/>
                  <StackPanel Orientation="Horizontal" Margin="0,25,0,0">
                    <Button Style="{StaticResource ActionButton}" Content="保存快捷键" Click="SaveHotkey_Click"/>
                    <Button Style="{StaticResource ActionButton}" Content="恢复默认" Click="RestoreDefault_Click"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
          <StackPanel x:Name="SystemPage" Visibility="Collapsed">
            <TextBlock Text="通用设置" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,18"/>
            <CheckBox x:Name="AutoUpdateToggle" Content="自动检查更新" Foreground="White" FontSize="16" IsEnabled="False" Margin="0,0,0,20" Checked="AutoUpdateToggle_Changed" Unchecked="AutoUpdateToggle_Changed"/>
            <CheckBox x:Name="OsdToggle" Content="屏幕操作提示 (OSD)" Foreground="White" FontSize="16" IsEnabled="False" Checked="OsdToggle_Changed" Unchecked="OsdToggle_Changed"/>
          </StackPanel>
          <ScrollViewer x:Name="PetPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="让熟悉的角色陪你工作" Foreground="White" FontSize="21" FontWeight="SemiBold"/>
              <TextBlock Text="选择本地 Live2D 模型，开启后可拖动角色、用滚轮调整大小。" Foreground="#BFD8EF" Margin="0,10,0,20" TextWrapping="Wrap"/>
              <Border Background="#CC1A2C3E" CornerRadius="16" Padding="18">
                <StackPanel>
                  <TextBlock Text="角色模型" Foreground="#FFDD38" FontSize="16"/>
                  <TextBlock x:Name="PetModelPath" Foreground="#BFD8EF" TextWrapping="Wrap" Margin="0,8,0,14"/>
                  <Button Content="选择模型…" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Click="ChoosePetModel_Click"/>
                  <CheckBox x:Name="PetEnabledToggle" Content="开启桌宠" Foreground="White" FontSize="16" Margin="0,22,0,14" Checked="PetEnabled_Changed" Unchecked="PetEnabled_Changed"/>
                  <WrapPanel>
                    <CheckBox x:Name="PetTopmostToggle" Content="始终置顶" Foreground="White" Margin="0,0,22,12" Checked="PetOptions_Changed" Unchecked="PetOptions_Changed"/>
                    <CheckBox x:Name="PetClickThroughToggle" Content="鼠标穿透" Foreground="White" Checked="PetOptions_Changed" Unchecked="PetOptions_Changed"/>
                  </WrapPanel>
                  <TextBlock Text="穿透后无法拖动角色，可回到这里或通过中控托盘解除。" Foreground="#91ABC1" TextWrapping="Wrap" FontSize="12"/>
                  <DockPanel Margin="0,20,0,10">
                    <TextBlock x:Name="PetSizeText" Foreground="#BFD8EF" Width="100" VerticalAlignment="Center"/>
                    <Slider x:Name="PetSizeSlider" Minimum="180" Maximum="1200" Value="360" TickFrequency="30" IsSnapToTickEnabled="True" ValueChanged="PetSize_Changed"/>
                  </DockPanel>
                  <TextBlock Text="按原始画布完整显示；透明留白可穿透。放大超出屏幕时会等比适配。" Foreground="#91ABC1" TextWrapping="Wrap" FontSize="12"/>
                  <DockPanel Margin="0,18,0,8">
                    <TextBlock Text="帧率上限" Foreground="#BFD8EF" Width="100" VerticalAlignment="Center"/>
                    <ComboBox x:Name="PetFrameLimit" Width="140" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectionChanged="PetFrameLimit_Changed">
                      <ComboBoxItem Content="30 FPS（默认）" Tag="30"/>
                      <ComboBoxItem Content="60 FPS" Tag="60"/>
                      <ComboBoxItem Content="90 FPS" Tag="90"/>
                      <ComboBoxItem Content="120 FPS" Tag="120"/>
                    </ComboBox>
                  </DockPanel>
                  <TextBlock x:Name="PetFrameRate" Foreground="#FFDD38" FontSize="14"/>
                  <TextBlock Text="当前数值为渲染统计，不代表屏幕实际显示帧率；受设备与刷新率影响。" Foreground="#91ABC1" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0"/>
                  <CheckBox x:Name="PetMouseFollow" Content="鼠标跟随（模型无眼球参数时轻微转头）" Foreground="White" Margin="0,16,0,10" Checked="PetInteractions_Changed" Unchecked="PetInteractions_Changed"/>
                  <CheckBox x:Name="PetHeadFollow" Content="眼球跟随时也轻微转头" Foreground="White" Margin="0,0,0,10" Checked="PetInteractions_Changed" Unchecked="PetInteractions_Changed"/>
                  <TextBlock x:Name="PetFollowAmountText" Foreground="White" Margin="0,4,0,4"/>
                  <Slider x:Name="PetFollowAmount" Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="PetFollow_Changed" ToolTip="最大转向幅度，占作者参数范围的比例"/>
                  <TextBlock x:Name="PetFollowSensitivityText" Foreground="White" Margin="0,10,0,4"/>
                  <Slider x:Name="PetFollowSensitivity" Minimum="0.5" Maximum="4" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="PetFollow_Changed" ToolTip="越高，鼠标移动较短距离就会产生明显转向"/>
                  <TextBlock x:Name="PetFollowSpeedText" Foreground="White" Margin="0,10,0,4"/>
                  <Slider x:Name="PetFollowSpeed" Minimum="0.5" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="PetFollow_Changed" ToolTip="越高越跟手，越低越柔和；始终平滑过渡"/>
                  <Button Content="恢复互动默认" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Margin="0,10,0,12" Click="PetResetInteractions_Click" ToolTip="三个互动开关全部开启，恢复跟随默认值及仅编辑器范围"/>
                  <CheckBox x:Name="PetTyping" Content="打字时播放敲键盘动作" Foreground="White" Margin="0,0,0,10" Checked="PetInteractions_Changed" Unchecked="PetInteractions_Changed"/>
                  <ComboBox x:Name="PetTypingScope" Width="260" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectionChanged="PetTypingScope_Changed">
                    <ComboBoxItem Content="仅 Kedit / Visual Studio" Tag="editors"/>
                    <ComboBoxItem Content="所有应用" Tag="all"/>
                  </ComboBox>
                  <TextBlock x:Name="PetScrollRateText" Foreground="White" Margin="0,12,0,4"/>
                  <Slider x:Name="PetScrollRate" Minimum="60" Maximum="3000" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="PetScroll_Changed"/>
                  <TextBlock x:Name="PetScrollSecondsText" Foreground="White" Margin="0,10,0,4"/>
                  <Slider x:Name="PetScrollSeconds" Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="PetScroll_Changed"/>
                  <TextBlock x:Name="PetTypingRate" Foreground="#FFDD38" TextWrapping="Wrap" Margin="0,8,0,4"/>
                  <TextBlock Text="先测量一整秒，再累计连续达标时间；降速或停顿会清零。已开始的文字会滚完当前一轮。停手后手部收尾，键盘保留 60 秒；仅统计按键活动，不记录输入内容。" Foreground="#AABBC9" TextWrapping="Wrap" Margin="0,8,0,4"/>
                  <TextBlock x:Name="PetInteractionStatus" Foreground="#FFDD38" TextWrapping="Wrap" Margin="0,0,0,10"/>
                  <WrapPanel Margin="0,10,0,0">
                    <Button Content="预览联动" Style="{StaticResource ActionButton}" Click="PreviewPet_Click"/>
                    <Button Content="恢复位置" Style="{StaticResource ActionButton}" Click="ResetPetPosition_Click"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Expander Header="互动与暖心陪伴" IsExpanded="True" Foreground="White" Margin="0,16,0,8">
                <StackPanel Margin="8">
                  <TextBlock Text="左键拖动 · 中键轻点头部摸摸头／身体轻戳 · 按住中键在头部移动揉头 · 滚轮缩放。" TextWrapping="Wrap" Foreground="#91ABC1" Margin="0,0,0,8"/>
                  <WrapPanel>
                    <Button Content="摸摸头" Tag="head" Style="{StaticResource ActionButton}" Click="PetCompanion_Click"/>
                    <Button Content="轻戳一下" Tag="body" Style="{StaticResource ActionButton}" Click="PetCompanion_Click"/>
                    <Button Content="喝口水" Tag="drink" Style="{StaticResource ActionButton}" Click="PetCompanion_Click"/>
                    <Button Content="吃点饭" Tag="eat" Style="{StaticResource ActionButton}" Click="PetCompanion_Click"/>
                    <Button Content="拿起剑" Tag="weapon" Style="{StaticResource ActionButton}" Click="PetCompanion_Click"/>
                    <Button Content="恢复自然状态" Tag="reset" Style="{StaticResource ActionButton}" Click="PetCompanion_Click"/>
                  </WrapPanel>
                  <TextBlock Text="手动道具会保持到退出，普通按键不会抢走道具。穿透开启时也可使用这些按钮。" TextWrapping="Wrap" Foreground="#91ABC1" Margin="0,8,0,12"/>
                  <CheckBox x:Name="PetCare" Content="自动暖心关心" Foreground="White" Checked="PetCare_Changed" Unchecked="PetCare_Changed"/>
                  <TextBlock x:Name="PetBubbleOffsetText" Foreground="White" Margin="0,12,0,4"/>
                  <Slider x:Name="PetBubbleOffset" Minimum="0" Maximum="70" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="PetPresentation_Changed" ToolTip="数值越大气泡越低，随角色缩放；0 为原来的顶部位置"/>
                  <TextBlock x:Name="PetMouthAmountText" Foreground="White" Margin="0,10,0,4"/>
                  <Slider x:Name="PetMouthAmount" Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="PetPresentation_Changed" ToolTip="说话时嘴部最大张合幅度；保留平滑闭嘴与固定嘴型优先规则"/>
                  <Button Content="预览气泡与嘴动" Tag="speechPreview" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Margin="0,8,0,8" Click="PetCompanion_Click"/>
                  <TextBlock Text="持剑甩动（仅拿剑时生效，需开启鼠标跟随）" Foreground="White" Margin="0,12,0,8"/>
                  <TextBlock x:Name="PetSwordSensitivityText" Foreground="White"/>
                  <Slider x:Name="PetSwordSensitivity" Minimum="0.5" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="PetSword_Changed"/>
                  <TextBlock x:Name="PetSwordAmountText" Foreground="White" Margin="0,8,0,0"/>
                  <Slider x:Name="PetSwordAmount" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="PetSword_Changed"/>
                  <TextBlock x:Name="PetSwordHeadText" Foreground="White" Margin="0,8,0,0"/>
                  <Slider x:Name="PetSwordHead" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="PetSword_Changed"/>
                  <TextBlock x:Name="PetSwordHeadSensitivityText" Foreground="White" Margin="0,8,0,0"/>
                  <Slider x:Name="PetSwordHeadSensitivity" Minimum="0.5" Maximum="4" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="PetSword_Changed" ToolTip="仅持剑时生效：越高，鼠标移动更短距离就能达到设定的头部幅度；不增加幅度上限"/>
                  <TextBlock x:Name="PetSwordHeadSpeedText" Foreground="White" Margin="0,8,0,0"/>
                  <Slider x:Name="PetSwordHeadSpeed" Minimum="0.5" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="PetSword_Changed" ToolTip="越高越跟手，越低越柔和；默认 1 倍对应约 180 毫秒平滑时间，不改变转头幅度"/>
                  <TextBlock Text="左右甩动为主，上下轻微配合；停手后余摆收势。挥剑期间头部持续柔和跟随，不再冻结等待。" TextWrapping="Wrap" Foreground="#91ABC1" Margin="0,8,0,8"/>
                  <ComboBox x:Name="PetCareFrequency" SelectedValuePath="Tag" SelectionChanged="PetCareFrequency_Changed" HorizontalAlignment="Left" Width="290" Margin="0,8,0,8">
                    <ComboBoxItem Content="较多：自动关心至少间隔 10 分钟" Tag="10"/>
                    <ComboBoxItem Content="适中：自动关心至少间隔 20 分钟" Tag="20"/>
                    <ComboBoxItem Content="较少：自动关心至少间隔 30 分钟" Tag="30"/>
                  </ComboBox>
                  <CheckBox x:Name="PetRest" Content="忙碌约 30 分钟后，在停手时温柔提醒休息" Foreground="White" Checked="PetCare_Changed" Unchecked="PetCare_Changed"/>
                  <TextBlock Text="依据当前监听范围内的匿名按键活动判断；没有合适停顿就不提醒，不追踪输入内容。" TextWrapping="Wrap" Foreground="#91ABC1" FontSize="12" Margin="0,8,0,8"/>
                  <WrapPanel>
                    <Button Content="安静一小时" Tag="quiet" Style="{StaticResource ActionButton}" Click="PetCompanion_Click"/>
                    <Button Content="取消临时安静" Tag="unquiet" Style="{StaticResource ActionButton}" Click="PetCompanion_Click"/>
                  </WrapPanel>
                  <TextBlock x:Name="PetQuietStatus" Foreground="#91ABC1" Margin="0,8,0,0"/>
                </StackPanel>
              </Expander>
              <Expander Header="表情与道具试衣间" IsExpanded="True" Foreground="White" Margin="0,8,0,8">
                <StackPanel Margin="8">
                  <ComboBox x:Name="PetResources" DisplayMemberPath="Display" SelectedValuePath="id" SelectionChanged="PetResource_Changed"/>
                  <TextBlock x:Name="PetResourceDetail" TextWrapping="Wrap" Foreground="#91ABC1" Margin="0,8,0,8"/>
                  <WrapPanel>
                    <Button Content="播放一次" Tag="once" Style="{StaticResource ActionButton}" Click="PetCompanion_Click"/>
                    <Button Content="保持显示" Tag="hold" Style="{StaticResource ActionButton}" Click="PetCompanion_Click"/>
                    <Button Content="保存组合" Tag="save" Style="{StaticResource ActionButton}" Click="PetCompanion_Click"/>
                    <Button Content="载入组合" Tag="restore" Style="{StaticResource ActionButton}" Click="PetCompanion_Click"/>
                  </WrapPanel>
                  <TextBlock Text="相同参数和手部道具互斥；面部、标记可搭配。仅主动换装改变外观。保存当前保持显示的组合，按模型区分；不会自动载入。" TextWrapping="Wrap" Foreground="#91ABC1" FontSize="12" Margin="0,8,0,8"/>
                  <TextBlock x:Name="PetCompanionStatus" Foreground="#FFDD38" TextWrapping="Wrap"/>
                </StackPanel>
              </Expander>
              <Expander Header="揉头、定时提醒与音乐陪伴" IsExpanded="True" Foreground="White" Margin="0,8,0,8">
                <ContentControl x:Name="PetAutomationHost"/>
              </Expander>
              <TextBlock x:Name="PetStatus" Foreground="#FFDD38" TextWrapping="Wrap" Margin="0,16,0,10"/>
              <TextBlock Text="桌宠开启时，关闭中控会收起面板；可从托盘重新打开或退出。桌宠与原有陪伴表情 OSD 分别控制。" Foreground="#91ABC1" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
        <TextBlock x:Name="PipeStatus" Grid.Row="2" Text="正在等待 Kedit 主程序连接..." Foreground="#BFD8EF" FontSize="12" TextWrapping="Wrap"/>
      </Grid>
    </Grid>
  </Border>
</Window>
