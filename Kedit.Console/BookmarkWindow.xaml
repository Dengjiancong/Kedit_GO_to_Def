<Window x:Class="Kedit.Console.BookmarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visual Studio 书签设置" Width="760" Height="500"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
  <Border Margin="12" CornerRadius="20" Background="#121D2B" BorderBrush="#3B5972" BorderThickness="1">
    <Grid Margin="28">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="×" Width="34" Height="30" Click="Close_Click"/>
        <TextBlock Text="Visual Studio 书签" FontSize="28" FontWeight="Bold" Foreground="White"/>
      </DockPanel>
      <Grid Grid.Row="1" Margin="0,24,0,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
        <Border Background="#182B3B" CornerRadius="14" Padding="18" Margin="0,0,18,0">
          <StackPanel>
            <TextBlock Text="功能演示" FontSize="17" FontWeight="SemiBold" Foreground="#FFDD38"/>
            <MediaElement x:Name="BookmarkVideo" Height="210" Margin="0,14,0,0" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" Volume="0" MediaEnded="BookmarkVideo_MediaEnded"/>
            <TextBlock Text="将视频放入 %TEMP%\Kedit_Media\shortcuts\vs_bookmark.mp4 即可播放。" Foreground="#C6D9E9" TextWrapping="Wrap" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="#182B3B" CornerRadius="14" Padding="18">
          <StackPanel>
            <TextBlock Text="快捷键设置" FontSize="17" FontWeight="SemiBold" Foreground="#FFDD38"/>
            <TextBlock Text="设置/取消书签" Foreground="White" Margin="0,18,0,4"/>
            <TextBox x:Name="ToggleInput" Padding="6,4" PreviewKeyDown="HotkeyInput_PreviewKeyDown"/>
            <TextBlock Text="下一个书签" Foreground="White" Margin="0,12,0,4"/>
            <TextBox x:Name="NextInput" Padding="6,4" PreviewKeyDown="HotkeyInput_PreviewKeyDown"/>
            <TextBlock Text="上一个书签" Foreground="White" Margin="0,12,0,4"/>
            <TextBox x:Name="PreviousInput" Padding="6,4" PreviewKeyDown="HotkeyInput_PreviewKeyDown"/>
            <TextBlock Text="点击输入框后直接按下快捷键" Foreground="#BFD8EF" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Grid>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="恢复默认" Click="RestoreDefaults_Click" Padding="14,6" Margin="0,0,10,0"/>
        <Button Content="保存设置" Click="Save_Click" Padding="14,6"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
